# Base URL for the Movie & TV Matchmaker API.
# Defaults to http://localhost:4000/api if unset (works from the iOS Simulator,
# which shares the Mac's network).
#
# When testing on a real device instead of the Simulator, change this to your
# Mac's LAN IP, e.g. http://192.168.1.23:4000/api -- no code change needed.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
