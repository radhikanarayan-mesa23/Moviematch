# Claude (optional — server falls back to deterministic logic if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# TMDB (required for pool generation)
TMDB_API_KEY=

# RapidAPI Streaming Availability (required for Indian OTT lookup on match)
RAPIDAPI_KEY=

# Supabase (required — service-role key, server-only, never expose to clients)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=4000
